<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartApplyHub.Mobile.ViewModels"
             x:Class="SmartApplyHub.Mobile.Pages.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Profile">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Your profile" Style="{StaticResource PageTitle}" FontSize="24" />
            <Label Text="{Binding QuotaSummary}" Style="{StaticResource Subtitle}"
                   IsVisible="{Binding QuotaSummary, Converter={StaticResource StringToBoolConverter}}" />
            <Label Text="{Binding Plan, StringFormat='Plan: {0}'}" TextColor="{StaticResource Primary}" FontAttributes="Bold"
                   IsVisible="{Binding Plan, Converter={StaticResource StringToBoolConverter}}" />

            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
            <Label Text="{Binding SuccessMessage}" Style="{StaticResource SuccessLabel}"
                   IsVisible="{Binding SuccessMessage, Converter={StaticResource StringToBoolConverter}}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" HorizontalOptions="Center" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Personal info" Style="{StaticResource SectionTitle}" Margin="0" />
                    <Entry Placeholder="Full name" Text="{Binding FullName}" />
                    <Entry Placeholder="Job title" Text="{Binding Title}" />
                    <Entry Placeholder="Phone" Text="{Binding Phone}" Keyboard="Telephone" />
                    <Entry Placeholder="Contact email" Text="{Binding ContactEmail}" Keyboard="Email" />
                    <Label Text="Skills" Style="{StaticResource FieldLabel}" />
                    <Editor Placeholder="Key skills..." Text="{Binding SkillsSummary}" HeightRequest="80" />
                    <Label Text="Experience" Style="{StaticResource FieldLabel}" />
                    <Editor Placeholder="Experience summary..." Text="{Binding ExperienceSummary}" HeightRequest="110" />
                    <Button Text="Save profile" Command="{Binding SaveProfileCommand}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Fill from CV" Command="{Binding FillFromCvCommand}" Style="{StaticResource SecondaryButton}" Grid.Column="0" />
                        <Button Text="Rewrite experience" Command="{Binding RewriteExperienceCommand}" Style="{StaticResource SecondaryButton}" Grid.Column="1" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="CV / Resume" Style="{StaticResource SectionTitle}" Margin="0" />
                    <Label Text="{Binding CvFileName, StringFormat='Current: {0}'}"
                           IsVisible="{Binding CvFileName, Converter={StaticResource StringToBoolConverter}}" />
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Upload CV" Command="{Binding UploadCvCommand}" />
                        <Button Text="Delete CV" Command="{Binding DeleteCvCommand}" Style="{StaticResource DangerButton}"
                                IsVisible="{Binding CvFileName, Converter={StaticResource StringToBoolConverter}}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Gmail App Password" Style="{StaticResource SectionTitle}" Margin="0" />
                    <Label Text="Required to send application emails from your Gmail." Style="{StaticResource Subtitle}" />
                    <Entry Placeholder="Gmail address" Text="{Binding SenderEmail}" Keyboard="Email" />
                    <Entry Placeholder="Display name" Text="{Binding SenderName}" />
                    <Entry Placeholder="App Password" Text="{Binding AppPassword}" IsPassword="True" />
                    <Button Text="Save email credential" Command="{Binding SaveEmailCredentialCommand}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
