<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartApplyHub.Mobile.ViewModels"
             x:Class="SmartApplyHub.Mobile.Pages.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Profile">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
            <Label Text="{Binding SuccessMessage}" TextColor="{StaticResource Success}"
                   IsVisible="{Binding SuccessMessage, Converter={StaticResource StringToBoolConverter}}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

            <!-- Profile Section -->
            <Label Text="Personal Info" FontSize="20" FontAttributes="Bold" />
            <Entry Placeholder="Full Name" Text="{Binding FullName}" />
            <Entry Placeholder="Job Title" Text="{Binding Title}" />
            <Entry Placeholder="Phone" Text="{Binding Phone}" Keyboard="Telephone" />
            <Entry Placeholder="Contact Email" Text="{Binding ContactEmail}" Keyboard="Email" />

            <Label Text="Skills Summary" FontAttributes="Bold" />
            <Editor Placeholder="List your key skills..." Text="{Binding SkillsSummary}"
                    HeightRequest="80" AutoSize="TextChanges" />

            <Label Text="Experience Summary" FontAttributes="Bold" />
            <Editor Placeholder="Describe your experience..." Text="{Binding ExperienceSummary}"
                    HeightRequest="100" AutoSize="TextChanges" />

            <Button Text="Save Profile" Command="{Binding SaveProfileCommand}" />

            <!-- CV Section -->
            <BoxView HeightRequest="1" Color="{StaticResource LightGray}" Margin="0,8" />
            <Label Text="CV / Resume" FontSize="20" FontAttributes="Bold" />
            <Label Text="{Binding CvFileName, StringFormat='Current: {0}'}"
                   IsVisible="{Binding CvFileName, Converter={StaticResource StringToBoolConverter}}" />
            <HorizontalStackLayout Spacing="12">
                <Button Text="Upload CV" Command="{Binding UploadCvCommand}" />
                <Button Text="Delete CV" Command="{Binding DeleteCvCommand}"
                        BackgroundColor="{StaticResource Danger}"
                        IsVisible="{Binding CvFileName, Converter={StaticResource StringToBoolConverter}}" />
            </HorizontalStackLayout>

            <!-- Email Credential Section -->
            <BoxView HeightRequest="1" Color="{StaticResource LightGray}" Margin="0,8" />
            <Label Text="Gmail App Password" FontSize="20" FontAttributes="Bold" />
            <Entry Placeholder="Gmail address" Text="{Binding SenderEmail}" Keyboard="Email" />
            <Entry Placeholder="Display name" Text="{Binding SenderName}" />
            <Entry Placeholder="App Password (16 chars)" Text="{Binding AppPassword}" IsPassword="True" />
            <Button Text="Save Email Credential" Command="{Binding SaveEmailCredentialCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
