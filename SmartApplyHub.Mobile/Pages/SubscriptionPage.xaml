<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartApplyHub.Mobile.ViewModels"
             xmlns:models="clr-namespace:SmartApplyHub.Shared.Models;assembly=SmartApplyHub.Shared"
             x:Class="SmartApplyHub.Mobile.Pages.SubscriptionPage"
             x:DataType="vm:SubscriptionViewModel"
             Title="Subscription">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Plans &amp; requests" Style="{StaticResource PageTitle}" FontSize="24" />
            <Label Text="Request an upgrade or token reset — admin will review it." Style="{StaticResource Subtitle}" />

            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
            <Label Text="{Binding SuccessMessage}" Style="{StaticResource SuccessLabel}"
                   IsVisible="{Binding SuccessMessage, Converter={StaticResource StringToBoolConverter}}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" HorizontalOptions="Center" />

            <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource PrimarySoft}" StrokeThickness="0">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Your plan" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    <Label Text="{Binding Quota.Plan}" FontSize="22" FontAttributes="Bold" />
                    <Label TextColor="{StaticResource TextSecondary}">
                        <Label.Text>
                            <MultiBinding StringFormat="{}AI quota: {0} / {1} used">
                                <Binding Path="Quota.Used" />
                                <Binding Path="Quota.Limit" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource WarningSoft}" StrokeThickness="0"
                    IsVisible="{Binding HasPendingSubscription}">
                <Label Text="{Binding PendingSubscriptionText}" TextColor="{StaticResource Warning}" FontAttributes="Bold" />
            </Border>
            <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource WarningSoft}" StrokeThickness="0"
                    IsVisible="{Binding HasPendingTokenReset}">
                <Label Text="{Binding PendingTokenResetText}" TextColor="{StaticResource Warning}" FontAttributes="Bold" />
            </Border>

            <Label Text="Available plans" Style="{StaticResource SectionTitle}" />
            <CollectionView ItemsSource="{Binding Plans}" HeightRequest="280">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:PlanInfoDto">
                        <Border Stroke="{StaticResource Border}" StrokeThickness="1" Margin="0,0,0,10"
                                BackgroundColor="White" Padding="14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SubscriptionViewModel}}, Path=SelectPlanCommand}"
                                    CommandParameter="{Binding}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Plan}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                    <Label Text="{Binding MonthlyPriceUsd, StringFormat='${0:0}/mo'}" Grid.Column="1"
                                           FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                                <Label Text="{Binding AiPerMonth, StringFormat='{0} AI analyses / month'}" />
                                <Label Text="{Binding BulkMaxRecipients, StringFormat='{0} bulk recipients'}" Style="{StaticResource Subtitle}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Request upgrade" Style="{StaticResource SectionTitle}" Margin="0" />
                    <Picker Title="Select plan" ItemsSource="{Binding UpgradePlans}" SelectedItem="{Binding SelectedPlan}" />
                    <Entry Placeholder="Note for admin (optional)" Text="{Binding Note}" />
                    <Button Text="Request subscription" Command="{Binding RequestSubscriptionCommand}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Request token reset" Style="{StaticResource SectionTitle}" Margin="0" />
                    <Label Text="Ask admin to reset your monthly AI usage." Style="{StaticResource Subtitle}" />
                    <Button Text="Request token reset" Command="{Binding RequestTokenResetCommand}"
                            BackgroundColor="{StaticResource Warning}" TextColor="White" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
