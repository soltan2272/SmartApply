<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartApplyHub.Mobile.ViewModels"
             x:Class="SmartApplyHub.Mobile.Pages.SubscriptionPage"
             x:DataType="vm:SubscriptionViewModel"
             Title="Subscription">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
            <Label Text="{Binding SuccessMessage}" TextColor="{StaticResource Success}"
                   IsVisible="{Binding SuccessMessage, Converter={StaticResource StringToBoolConverter}}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

            <!-- Current Plan -->
            <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Your Plan" FontSize="20" FontAttributes="Bold" />
                    <Label Text="{Binding Quota.Plan, StringFormat='Current: {0}'}" FontSize="16" />
                    <Label TextColor="{StaticResource DarkGray}">
                        <Label.Text>
                            <MultiBinding StringFormat="{}AI Quota: {0} / {1} used">
                                <Binding Path="Quota.Used" />
                                <Binding Path="Quota.Limit" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                </VerticalStackLayout>
            </Frame>

            <!-- Plans List -->
            <Label Text="Available Plans" FontSize="20" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding Plans}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SubscriptionViewModel">
                        <Frame Padding="12" Margin="0,4" CornerRadius="8" HasShadow="True" BackgroundColor="White">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Plan}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding AiPerMonth, StringFormat='{0} AI analyses/month'}" />
                                <Label Text="{Binding BulkMaxRecipients, StringFormat='{0} bulk recipients'}" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Request Subscription -->
            <BoxView HeightRequest="1" Color="{StaticResource LightGray}" Margin="0,8" />
            <Label Text="Request Plan Upgrade" FontSize="18" FontAttributes="Bold" />
            <Picker Title="Select Plan" SelectedItem="{Binding SelectedPlan}">
                <Picker.Items>
                    <x:String>Pro</x:String>
                    <x:String>Power</x:String>
                </Picker.Items>
            </Picker>
            <Entry Placeholder="Note (optional)" Text="{Binding Note}" />
            <Button Text="Request Subscription" Command="{Binding RequestSubscriptionCommand}" />

            <!-- Request Token Reset -->
            <BoxView HeightRequest="1" Color="{StaticResource LightGray}" Margin="0,8" />
            <Label Text="Request Token Reset" FontSize="18" FontAttributes="Bold" />
            <Label Text="Request admin to reset your monthly AI usage tokens."
                   TextColor="{StaticResource DarkGray}" FontSize="13" />
            <Button Text="Request Token Reset" Command="{Binding RequestTokenResetCommand}"
                    BackgroundColor="{StaticResource Warning}" TextColor="{StaticResource TextPrimary}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
