<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartApplyHub.Mobile.ViewModels"
             xmlns:models="clr-namespace:SmartApplyHub.Shared.Models;assembly=SmartApplyHub.Shared"
             x:Class="SmartApplyHub.Mobile.Pages.JobSearchPage"
             x:DataType="vm:JobSearchViewModel"
             Title="Search Jobs">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">
        <Border Style="{StaticResource Card}" Grid.Row="0" Padding="14">
            <VerticalStackLayout Spacing="10">
                <Label Text="Find roles" Style="{StaticResource SectionTitle}" Margin="0" />
                <Entry Placeholder="Job title (e.g. .NET Developer)" Text="{Binding Title}" />
                <Entry Placeholder="Location" Text="{Binding Location}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Picker Title="Experience" ItemsSource="{Binding ExperienceLevels}"
                            ItemDisplayBinding="{Binding Label}"
                            SelectedItem="{Binding SelectedExperience}" Grid.Column="0" />
                    <Picker Title="Date posted" ItemsSource="{Binding DatePostedOptions}"
                            ItemDisplayBinding="{Binding Label}"
                            SelectedItem="{Binding SelectedDatePosted}" Grid.Column="1" />
                </Grid>
                <Button Text="Search" Command="{Binding SearchCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}" HorizontalOptions="Center" />
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
                <Label Text="{Binding ResultsSummary}" Style="{StaticResource Subtitle}"
                       IsVisible="{Binding HasSearched}" />
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Results}">
            <CollectionView.EmptyView>
                <Label Text="Search for jobs to see results here."
                       HorizontalOptions="Center" VerticalOptions="Center"
                       TextColor="{StaticResource TextMuted}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:JobSearchResultDto">
                    <Border Stroke="{StaticResource Border}" StrokeThickness="1" Margin="0,0,0,10"
                            BackgroundColor="White" Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:JobSearchViewModel}}, Path=SelectJobCommand}"
                                CommandParameter="{Binding}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" />
                                <Border Style="{StaticResource Chip}" Grid.Column="1">
                                    <Label Text="{Binding ResultType}" FontSize="11" TextColor="{StaticResource Primary}" />
                                </Border>
                            </Grid>
                            <Label Text="{Binding Company}" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                            <Label Text="{Binding Location}" TextColor="{StaticResource TextSecondary}" FontSize="12" />
                            <Label Text="{Binding DatePosted}" TextColor="{StaticResource TextMuted}" FontSize="11" />
                            <Label Text="{Binding Snippet}" FontSize="12" TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="TailTruncation" MaxLines="2" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="16" Padding="0,8"
                                       IsVisible="{Binding HasSearched}">
                    <Button Text="Previous" Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding CanGoPrevious}" Style="{StaticResource SecondaryButton}"
                            FontSize="13" Padding="12,8" />
                    <Label VerticalOptions="Center" TextColor="{StaticResource TextSecondary}">
                        <Label.Text>
                            <MultiBinding StringFormat="{}{0} / {1}">
                                <Binding Path="CurrentPage" />
                                <Binding Path="TotalPages" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                    <Button Text="Next" Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding CanGoNext}" Style="{StaticResource SecondaryButton}"
                            FontSize="13" Padding="12,8" />
                </HorizontalStackLayout>
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>
