<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartApplyHub.Mobile.ViewModels"
             xmlns:models="clr-namespace:SmartApplyHub.Shared.Models;assembly=SmartApplyHub.Shared"
             x:Class="SmartApplyHub.Mobile.Pages.ApplicationsPage"
             x:DataType="vm:ApplicationsViewModel"
             Title="Applications">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="10">
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
            <Label Text="{Binding SuccessMessage}" Style="{StaticResource SuccessLabel}"
                   IsVisible="{Binding SuccessMessage, Converter={StaticResource StringToBoolConverter}}" />
            <Picker Title="Filter by pipeline" ItemsSource="{Binding FilterOptions}"
                    SelectedItem="{Binding FilterStatus}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Applications}">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="8" Margin="0,0,0,8"
                                     IsVisible="{Binding HasDueFollowUps}">
                    <Label Text="Due follow-ups" Style="{StaticResource SectionTitle}" Margin="0" />
                    <CollectionView ItemsSource="{Binding DueFollowUps}" HeightRequest="140">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ApplicationDto">
                                <Border BackgroundColor="{StaticResource WarningSoft}" Padding="12" Margin="0,0,0,8" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout>
                                            <Label Text="{Binding JobTitle}" FontAttributes="Bold" />
                                            <Label Text="{Binding CompanyName}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                        </VerticalStackLayout>
                                        <Button Text="Send" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ApplicationsViewModel}}, Path=SendFollowUpCommand}"
                                                CommandParameter="{Binding}" Style="{StaticResource SuccessButton}"
                                                FontSize="12" Padding="10,6" Grid.Column="1" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <Label Text="No applications yet."
                       HorizontalOptions="Center" VerticalOptions="Center"
                       TextColor="{StaticResource TextMuted}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ApplicationDto">
                    <Border Stroke="{StaticResource Border}" StrokeThickness="1" Margin="0,0,0,10"
                            BackgroundColor="White" Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding JobTitle}" FontSize="15" FontAttributes="Bold" />
                                <Border Style="{StaticResource Chip}" Grid.Column="1">
                                    <Label Text="{Binding PipelineStatus}" FontSize="11" TextColor="{StaticResource Primary}" />
                                </Border>
                            </Grid>
                            <Label Text="{Binding CompanyName}" TextColor="{StaticResource TextSecondary}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding CreatedAt, StringFormat='{0:MMM dd, yyyy}'}" FontSize="11" TextColor="{StaticResource TextMuted}" />
                                <Label Text="{Binding MatchScore, StringFormat='Match {0}%'}" FontSize="11"
                                       TextColor="{StaticResource TextMuted}" Grid.Column="1" />
                            </Grid>
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Pipeline" FontSize="12" Padding="10,6"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ApplicationsViewModel}}, Path=UpdatePipelineCommand}"
                                        CommandParameter="{Binding}" />
                                <Button Text="Follow-up" FontSize="12" Padding="10,6" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ApplicationsViewModel}}, Path=ScheduleFollowUpCommand}"
                                        CommandParameter="{Binding}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center" Spacing="16">
            <Button Text="Previous" Command="{Binding PreviousPageCommand}"
                    IsEnabled="{Binding CanGoPrevious}" Style="{StaticResource SecondaryButton}"
                    FontSize="13" Padding="12,8" />
            <Label VerticalOptions="Center" TextColor="{StaticResource TextSecondary}">
                <Label.Text>
                    <MultiBinding StringFormat="{}{0} / {1}">
                        <Binding Path="CurrentPage" />
                        <Binding Path="TotalPages" />
                    </MultiBinding>
                </Label.Text>
            </Label>
            <Button Text="Next" Command="{Binding NextPageCommand}"
                    IsEnabled="{Binding CanGoNext}" Style="{StaticResource SecondaryButton}"
                    FontSize="13" Padding="12,8" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
