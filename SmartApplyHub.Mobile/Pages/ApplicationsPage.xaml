<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartApplyHub.Mobile.ViewModels"
             x:Class="SmartApplyHub.Mobile.Pages.ApplicationsPage"
             x:DataType="vm:ApplicationsViewModel"
             Title="Applications">

    <Grid RowDefinitions="*,Auto" Padding="16" RowSpacing="8">

        <CollectionView Grid.Row="0" ItemsSource="{Binding Applications}">
            <CollectionView.EmptyView>
                <Label Text="No applications yet."
                       HorizontalOptions="Center" VerticalOptions="Center"
                       TextColor="{StaticResource DarkGray}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ApplicationsViewModel">
                    <Frame Padding="12" Margin="0,4" CornerRadius="8" HasShadow="True" BackgroundColor="White">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ApplicationsViewModel}}, Path=UpdatePipelineCommand}"
                                CommandParameter="{Binding}" />
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                            <Label Text="{Binding JobTitle}" FontSize="15" FontAttributes="Bold"
                                   Grid.Row="0" Grid.Column="0" />
                            <Label Text="{Binding PipelineStatus}" FontSize="12"
                                   Grid.Row="0" Grid.Column="1" TextColor="{StaticResource Primary}" />
                            <Label Text="{Binding CompanyName}" FontSize="13" TextColor="{StaticResource DarkGray}"
                                   Grid.Row="1" Grid.Column="0" />
                            <Label Text="{Binding Status}" FontSize="12"
                                   Grid.Row="1" Grid.Column="1" />
                            <Label Grid.Row="2" Grid.Column="0" FontSize="11" TextColor="{StaticResource DarkGray}"
                                   Text="{Binding CreatedAt, StringFormat='{0:MMM dd, yyyy}'}" />
                            <Label Grid.Row="2" Grid.Column="1" FontSize="11" TextColor="{StaticResource DarkGray}"
                                   Text="{Binding MatchScore, StringFormat='Match: {0}%'}" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Pagination -->
        <HorizontalStackLayout Grid.Row="1" HorizontalOptions="Center" Spacing="16">
            <Button Text="Previous" Command="{Binding PreviousPageCommand}"
                    IsEnabled="{Binding CanGoPrevious}" FontSize="13"
                    Padding="10,6" />
            <Label VerticalOptions="Center" FontSize="14">
                <Label.Text>
                    <MultiBinding StringFormat="{}{0} / {1}">
                        <Binding Path="CurrentPage" />
                        <Binding Path="TotalPages" />
                    </MultiBinding>
                </Label.Text>
            </Label>
            <Button Text="Next" Command="{Binding NextPageCommand}"
                    IsEnabled="{Binding CanGoNext}" FontSize="13"
                    Padding="10,6" />
        </HorizontalStackLayout>

    </Grid>
</ContentPage>
