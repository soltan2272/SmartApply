<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartApplyHub.Mobile.ViewModels"
             x:Class="SmartApplyHub.Mobile.Pages.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Register"
             BackgroundColor="{StaticResource PageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
            <Label Text="Create account" Style="{StaticResource PageTitle}" />
            <Label Text="Join SmartApply Hub and start applying with AI." Style="{StaticResource Subtitle}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Email" Style="{StaticResource FieldLabel}" />
                    <Entry Placeholder="you@email.com" Text="{Binding Email}" Keyboard="Email" />

                    <Label Text="Password" Style="{StaticResource FieldLabel}" />
                    <Entry Placeholder="Create a password" Text="{Binding Password}" IsPassword="True" />

                    <Label Text="Confirm password" Style="{StaticResource FieldLabel}" />
                    <Entry Placeholder="Repeat password" Text="{Binding ConfirmPassword}" IsPassword="True" />

                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
                    <Label Text="{Binding SuccessMessage}" Style="{StaticResource SuccessLabel}"
                           IsVisible="{Binding SuccessMessage, Converter={StaticResource StringToBoolConverter}}" />

                    <Button Text="Create account" Command="{Binding RegisterCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource Primary}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Already have an account? Log in"
                   TextColor="{StaticResource Primary}" HorizontalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
