<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartApplyHub.Mobile.ViewModels"
             x:Class="SmartApplyHub.Mobile.Pages.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Login"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Primary}">

    <Grid>
        <BoxView Color="{StaticResource Primary}" />
        <ScrollView>
            <VerticalStackLayout Padding="28" Spacing="0" VerticalOptions="Center">
                <Label Text="SmartApply Hub"
                       FontSize="34" FontAttributes="Bold"
                       TextColor="White" HorizontalOptions="Center" />
                <Label Text="Apply smarter. Track every opportunity."
                       Style="{StaticResource Subtitle}" TextColor="#C7D2FE"
                       HorizontalOptions="Center" Margin="0,6,0,28" />

                <Border Style="{StaticResource Card}" Padding="22" StrokeThickness="0">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Welcome back" Style="{StaticResource SectionTitle}" Margin="0" />
                        <Label Text="Sign in to continue" Style="{StaticResource Subtitle}" />

                        <Label Text="Email" Style="{StaticResource FieldLabel}" />
                        <Entry Placeholder="you@email.com" Text="{Binding Email}" Keyboard="Email" />

                        <Label Text="Password" Style="{StaticResource FieldLabel}" />
                        <Entry Placeholder="••••••••" Text="{Binding Password}" IsPassword="True" />

                        <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

                        <Button Text="Login" Command="{Binding LoginCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                           Color="{StaticResource Primary}" HorizontalOptions="Center" />

                        <Label Text="Don't have an account? Register"
                               TextColor="{StaticResource Primary}" HorizontalOptions="Center" Margin="0,4,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
