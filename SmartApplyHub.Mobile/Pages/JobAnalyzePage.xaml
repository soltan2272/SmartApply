<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartApplyHub.Mobile.ViewModels"
             x:Class="SmartApplyHub.Mobile.Pages.JobAnalyzePage"
             x:DataType="vm:JobAnalyzeViewModel"
             Title="Apply with AI">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Analyze &amp; apply" Style="{StaticResource PageTitle}" FontSize="24" />
            <Label Text="Paste a job URL or description. Edit the email before sending." Style="{StaticResource Subtitle}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Job URL" Style="{StaticResource FieldLabel}" />
                    <Entry Placeholder="https://..." Text="{Binding JobUrl}" />
                    <Label Text="or paste description" Style="{StaticResource FieldLabel}" />
                    <Editor Placeholder="Paste the full job description..."
                            Text="{Binding JobDescription}" HeightRequest="120" AutoSize="Disabled" />
                    <Button Text="Analyze with AI" Command="{Binding AnalyzeCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" HorizontalOptions="Center" />
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
            <Label Text="{Binding SuccessMessage}" Style="{StaticResource SuccessLabel}"
                   IsVisible="{Binding SuccessMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Border Style="{StaticResource Card}" IsVisible="{Binding IsAnalyzed}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Email preview" Style="{StaticResource SectionTitle}" Margin="0" />
                        <Border Style="{StaticResource Chip}" Grid.Column="1" BackgroundColor="{StaticResource SuccessSoft}">
                            <Label Text="{Binding MatchScore, StringFormat='{0}% match'}"
                                   TextColor="{StaticResource Success}" FontAttributes="Bold" FontSize="12" />
                        </Border>
                    </Grid>

                    <Label Text="{Binding JobTitle}" FontAttributes="Bold" />
                    <Label Text="{Binding CompanyName}" TextColor="{StaticResource Primary}" />
                    <Label Text="{Binding MatchedSkillsText}" Style="{StaticResource Subtitle}" FontSize="12" />
                    <Label Text="CV on file — will be attached"
                           TextColor="{StaticResource Success}" FontSize="12"
                           IsVisible="{Binding HasCvOnFile}" />
                    <Label Text="No CV on file — upload one in Profile before sending"
                           TextColor="{StaticResource Warning}" FontSize="12"
                           IsVisible="{Binding HasCvOnFile, Converter={StaticResource InvertedBoolConverter}}" />

                    <Label Text="To" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding ToEmail}" Keyboard="Email" />
                    <Label Text="Subject" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Subject}" />
                    <Label Text="Body" Style="{StaticResource FieldLabel}" />
                    <Editor Text="{Binding Body}" HeightRequest="180" AutoSize="Disabled" />

                    <Button Text="Send email" Command="{Binding SendEmailCommand}" Style="{StaticResource SuccessButton}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
