@model JobApplicationBot.Models.BillingPageViewModel
@{
    ViewData["Title"] = "Plans & Requests";
}

<div class="row justify-content-center">
    <div class="col-lg-11">
        <div class="page-hero">
            <h1>
                <i class="bi bi-credit-card hero-icon me-2"></i>
                Plans &amp; Requests
            </h1>
            <p class="lead">Request a plan upgrade or AI token reset. An admin reviews every request.</p>
        </div>

        @if (TempData["BillingSuccess"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@success
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["BillingError"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@error
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="card card-main mb-4">
                <div class="card-body d-flex flex-wrap justify-content-between gap-3 align-items-center">
                    <div>
                        <div class="text-muted small">Current plan</div>
                        <div class="fs-4 fw-bold">@Model.CurrentPlan</div>
                        <div class="small text-muted">AI tokens this month: @Model.QuotaUsed / @Model.QuotaLimit</div>
                    </div>
                    @if (Model.HasPendingSubscriptionRequest)
                    {
                        <span class="badge bg-warning text-dark">Pending upgrade: @Model.PendingSubscriptionPlan</span>
                    }
                    @if (Model.HasPendingTokenResetRequest)
                    {
                        <span class="badge bg-warning text-dark">Pending token reset</span>
                    }
                </div>
            </div>
        }

        <div class="row g-4 mb-4">
            @foreach (var plan in Model.Plans)
            {
                var isCurrent = string.Equals(plan.Plan, Model.CurrentPlan, StringComparison.OrdinalIgnoreCase);
                <div class="col-md-4">
                    <div class="card card-main h-100 @(isCurrent ? "border-primary" : "")">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h3 class="h4 mb-0">@plan.Plan</h3>
                                @if (isCurrent)
                                {
                                    <span class="badge bg-primary">Current</span>
                                }
                            </div>
                            <div class="mb-3">
                                @if (plan.MonthlyPriceUsd <= 0)
                                {
                                    <span class="fs-2 fw-bold">Free</span>
                                }
                                else
                                {
                                    <span class="fs-2 fw-bold">$@plan.MonthlyPriceUsd.ToString("0")</span>
                                    <span class="text-muted">/mo (manual)</span>
                                }
                            </div>
                            <ul class="list-unstyled text-brand-muted flex-grow-1">
                                <li class="mb-2"><i class="bi bi-check2 text-success me-1"></i>@plan.AiPerMonth AI analyses / month</li>
                                <li class="mb-2"><i class="bi bi-check2 text-success me-1"></i>Bulk send up to @plan.BulkMaxRecipients</li>
                            </ul>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                @if (plan.Plan == "Free" || isCurrent)
                                {
                                    <button class="btn btn-outline-custom w-100" disabled>@(isCurrent ? "Your plan" : "Default plan")</button>
                                }
                                else if (Model.HasPendingSubscriptionRequest)
                                {
                                    <button class="btn btn-outline-custom w-100" disabled>Request pending</button>
                                }
                                else
                                {
                                    <form asp-action="RequestSubscription" method="post">
                                        <input type="hidden" name="plan" value="@plan.Plan" />
                                        <button type="submit" class="btn btn-primary-gradient w-100">Request @plan.Plan</button>
                                    </form>
                                }
                            }
                            else
                            {
                                <a class="btn btn-primary-gradient w-100" asp-area="Identity" asp-page="/Account/Register">Get Started</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="card card-main">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-arrow-counterclockwise me-2"></i>Request AI token reset</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small">Ask an admin to reset your monthly AI usage counter to zero.</p>
                    @if (Model.HasPendingTokenResetRequest)
                    {
                        <div class="alert alert-warning mb-0">You already have a pending token reset request.</div>
                    }
                    else
                    {
                        <form asp-action="RequestTokenReset" method="post" class="row g-2 align-items-end">
                            <div class="col-md-8">
                                <label class="form-label">Optional note</label>
                                <input type="text" name="note" class="form-control" maxlength="500" placeholder="Why do you need more tokens?" />
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-outline-custom w-100">Request reset</button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
</div>
