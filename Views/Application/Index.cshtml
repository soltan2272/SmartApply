@model JobApplicationBot.Models.ApplicationDashboardViewModel
@{
    ViewData["Title"] = "Applications";
}

<div class="row justify-content-center">
    <div class="col-lg-11">
        <div class="page-hero">
            <h1>
                <i class="bi bi-kanban hero-icon me-2"></i>
                Application CRM
            </h1>
            <p class="lead">Track delivery, pipeline stage, match scores, and follow-ups in one place.</p>
        </div>

        @if (TempData["ApplicationsSuccess"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@success
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ApplicationsError"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@error
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row g-3 mb-4">
            <div class="col-6 col-md-2">
                <div class="card card-main h-100">
                    <div class="card-body">
                        <div class="text-muted small">Total</div>
                        <div class="fs-3 fw-bold">@Model.TotalApplications</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card card-main h-100">
                    <div class="card-body">
                        <div class="text-muted small">Sent</div>
                        <div class="fs-3 fw-bold text-success">@Model.TotalSent</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card card-main h-100">
                    <div class="card-body">
                        <div class="text-muted small">Queued</div>
                        <div class="fs-3 fw-bold text-warning">@Model.TotalQueued</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card card-main h-100">
                    <div class="card-body">
                        <div class="text-muted small">Interviewing</div>
                        <div class="fs-3 fw-bold text-primary">@Model.PipelineInterviewing</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card card-main h-100">
                    <div class="card-body">
                        <div class="text-muted small">Offers</div>
                        <div class="fs-3 fw-bold text-success">@Model.PipelineOffer</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card card-main h-100">
                    <div class="card-body">
                        <div class="text-muted small">Rejected</div>
                        <div class="fs-3 fw-bold text-danger">@Model.PipelineRejected</div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.DueFollowUps.Count > 0)
        {
            <div class="card card-main mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-alarm me-2"></i>Due Follow-ups</h5>
                </div>
                <div class="card-body">
                    @foreach (var app in Model.DueFollowUps)
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <span class="fw-semibold">@app.JobTitle</span>
                            <span class="text-muted">(@app.CompanyName)</span>
                            <span class="text-muted small">@app.RecipientEmail</span>
                            <form asp-action="SendFollowUp" method="post" class="ms-auto">
                                <input type="hidden" name="id" value="@app.Id" />
                                <input type="hidden" name="page" value="@Model.CurrentPage" />
                                <button type="submit" class="btn btn-sm btn-primary-gradient">
                                    <i class="bi bi-send me-1"></i>Send Follow-up
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="card card-main">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-list-check me-2"></i>Recent Applications</h5>
            </div>
            <div class="card-body">
                @if (Model.Applications.Count == 0)
                {
                    <p class="text-muted mb-0">No applications recorded yet. Send your first application from the Apply with AI page.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                            <tr>
                                <th>Created</th>
                                <th>Type</th>
                                <th>Role / Company</th>
                                <th>Match</th>
                                <th>Delivery</th>
                                <th>Pipeline</th>
                                <th>Follow-up</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var app in Model.Applications)
                            {
                                <tr>
                                    <td class="small text-muted">@app.CreatedAt.ToLocalTime().ToString("g")</td>
                                    <td><span class="badge bg-secondary">@app.Source</span></td>
                                    <td>
                                        <div class="fw-semibold">@app.JobTitle</div>
                                        <div class="small text-muted">@app.CompanyName</div>
                                        <div class="small">@app.RecipientEmail</div>
                                    </td>
                                    <td>
                                        @if (app.MatchScore.HasValue)
                                        {
                                            <span class="fw-semibold">@app.MatchScore%</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (app.Status == JobApplicationBot.Data.Entities.JobApplicationStatus.Sent)
                                        {
                                            <span class="badge bg-success">Sent</span>
                                        }
                                        else if (app.Status == JobApplicationBot.Data.Entities.JobApplicationStatus.Failed)
                                        {
                                            <span class="badge bg-danger">Failed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Queued</span>
                                        }
                                    </td>
                                    <td>
                                        @if (app.Status == JobApplicationBot.Data.Entities.JobApplicationStatus.Sent)
                                        {
                                            <form asp-action="UpdatePipeline" method="post" class="d-flex gap-1">
                                                <input type="hidden" name="id" value="@app.Id" />
                                                <input type="hidden" name="page" value="@Model.CurrentPage" />
                                                <select name="pipelineStatus" class="form-select form-select-sm" onchange="this.form.submit()">
                                                    @foreach (var status in JobApplicationBot.Data.Entities.ApplicationPipelineStatus.All)
                                                    {
                                                        if (string.Equals(app.PipelineStatus, status, StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <option value="@status" selected>@status</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@status">@status</option>
                                                        }
                                                    }
                                                </select>
                                            </form>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(app.ErrorMessage))
                                        {
                                            <span class="small text-danger">@app.ErrorMessage</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">@app.PipelineStatus</span>
                                        }
                                    </td>
                                    <td>
                                        @if (app.Status == JobApplicationBot.Data.Entities.JobApplicationStatus.Sent
                                             && app.Source != JobApplicationBot.Data.Entities.JobApplicationSource.FollowUp)
                                        {
                                            <form asp-action="ScheduleFollowUp" method="post" class="d-flex gap-2">
                                                <input type="hidden" name="id" value="@app.Id" />
                                                <input type="hidden" name="page" value="@Model.CurrentPage" />
                                                <input type="datetime-local" name="nextFollowUpAt" class="form-control form-control-sm" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary">Set</button>
                                            </form>
                                            @if (app.NextFollowUpAt != null)
                                            {
                                                <div class="small text-muted mt-1">Due: @app.NextFollowUpAt.Value.ToLocalTime().ToString("g")</div>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>

                    @if (Model.TotalPages > 1)
                    {
                        <nav class="mt-3" aria-label="Applications pagination">
                            <ul class="pagination justify-content-center mb-0">
                                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
                                </li>
                                <li class="page-item disabled">
                                    <span class="page-link">Page @Model.CurrentPage of @Model.TotalPages (@Model.TotalCount total)</span>
                                </li>
                                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)">Next</a>
                                </li>
                            </ul>
                        </nav>
                    }
                }
            </div>
        </div>
    </div>
</div>
