@model JobApplicationBot.Models.JobSearchViewModel
@{
    ViewData["Title"] = "Search Jobs";
    var jobCount = Model.Results.Count(r => r.ResultType == "Job");
    var postCount = Model.Results.Count(r => r.ResultType == "Post");
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="text-center mb-4">
            <h1 class="fw-bold mb-2" style="color: #1a1a2e;">
                <i class="bi bi-search me-2" style="color: var(--gradient-start);"></i>
                Find Your Next Role in Egypt
            </h1>
            <p class="text-muted fs-5">Search LinkedIn job listings and posts in one place</p>
        </div>

        <div class="card card-main mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-funnel me-2"></i>Search Filters</h5>
            </div>
            <div class="card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form asp-controller="Job" asp-action="Search" method="post" id="searchForm">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-briefcase me-1 text-primary"></i>Job Title
                            </label>
                            <input asp-for="Filter.Title" class="form-control form-control-lg"
                                   placeholder="e.g. Software Engineer" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-bar-chart me-1 text-primary"></i>Experience Level
                            </label>
                            <select asp-for="Filter.ExperienceLevel" class="form-select form-select-lg">
                                <option value="">Any Level</option>
                                <option value="1">Internship</option>
                                <option value="2">Entry (0-2 yrs)</option>
                                <option value="3">Associate (2-5 yrs)</option>
                                <option value="4">Mid-Senior (5-10 yrs)</option>
                                <option value="5">Director (10+ yrs)</option>
                                <option value="6">Executive</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-calendar-event me-1 text-primary"></i>Date Posted
                            </label>
                            <select asp-for="Filter.DatePosted" class="form-select form-select-lg">
                                <option value="">Any Time</option>
                                <option value="r86400">Today</option>
                                <option value="r604800">Past Week</option>
                                <option value="r2592000">Past Month</option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary-gradient btn-lg w-100">
                                <i class="bi bi-search me-1"></i>Search
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        @if (Model.HasSearched)
        {
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <h5 class="fw-bold mb-0" style="color: #1a1a2e;">
                    <i class="bi bi-list-ul me-2" style="color: var(--gradient-start);"></i>
                    Results
                    <span class="badge rounded-pill ms-2" style="background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end)); font-size: 0.75rem;">
                        @Model.TotalCount result@(Model.TotalCount != 1 ? "s" : "")
                    </span>
                </h5>
                <div class="d-flex gap-2 align-items-center">
                    @if (jobCount > 0)
                    {
                        <span class="badge-category badge-job"><i class="bi bi-briefcase-fill me-1"></i>@jobCount Job@(jobCount != 1 ? "s" : "")</span>
                    }
                    @if (postCount > 0)
                    {
                        <span class="badge-category badge-post"><i class="bi bi-chat-square-text-fill me-1"></i>@postCount Post@(postCount != 1 ? "s" : "")</span>
                    }
                    @if (Model.TotalPages > 1)
                    {
                        <small class="text-muted ms-2">Page @Model.CurrentPage of @Model.TotalPages</small>
                    }
                </div>
            </div>

            @if (Model.TotalCount == 0)
            {
                <div class="card card-main">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
                        <h5 class="text-muted">No results found</h5>
                        <p class="text-muted mb-0">Try adjusting your filters or using a different job title.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var job in Model.PagedResults)
                    {
                        var isJob = job.ResultType == "Job";
                        <div class="col-md-6">
                            <div class="card card-main h-100 job-card">
                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="badge-category @(isJob ? "badge-job" : "badge-post")">
                                            <i class="bi @(isJob ? "bi-briefcase-fill" : "bi-chat-square-text-fill") me-1"></i>
                                            @(isJob ? "Job Listing" : "Post")
                                        </span>
                                    </div>

                                    <div class="d-flex align-items-start gap-3 mb-3">
                                        @if (isJob && !string.IsNullOrEmpty(job.LogoUrl))
                                        {
                                            <img src="@job.LogoUrl" alt="@job.Company"
                                                 class="rounded" style="width: 48px; height: 48px; object-fit: contain; flex-shrink: 0; background: #f5f5f5;"
                                                 onerror="this.style.display='none'" />
                                        }
                                        else
                                        {
                                            <div class="rounded d-flex align-items-center justify-content-center"
                                                 style="width: 48px; height: 48px; flex-shrink: 0; background: @(isJob ? "linear-gradient(135deg, var(--gradient-start), var(--gradient-end))" : "linear-gradient(135deg, #f093fb, #f5576c)");">
                                                <i class="bi @(isJob ? "bi-building" : "bi-person-circle") text-white fs-5"></i>
                                            </div>
                                        }
                                        <div class="flex-grow-1 min-width-0">
                                            <h6 class="fw-bold mb-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;" title="@job.Title">
                                                @job.Title
                                            </h6>
                                            <p class="text-muted mb-0 small">
                                                <i class="bi @(isJob ? "bi-building" : "bi-person") me-1"></i>@job.Company
                                            </p>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(job.Snippet))
                                    {
                                        <p class="text-muted small mb-3" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                            @job.Snippet
                                        </p>
                                    }

                                    <div class="d-flex flex-wrap gap-2 mb-3 small">
                                        @if (!string.IsNullOrEmpty(job.Location))
                                        {
                                            <span class="skill-badge">
                                                <i class="bi bi-geo-alt me-1"></i>@job.Location
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(job.DatePosted))
                                        {
                                            <span class="skill-badge">
                                                <i class="bi bi-clock me-1"></i>@FormatDate(job.DatePosted)
                                            </span>
                                        }
                                    </div>

                                    <div class="mt-auto d-flex gap-2">
                                        @if (!string.IsNullOrEmpty(job.Url))
                                        {
                                            @if (isJob)
                                            {
                                                <a href="@job.Url" target="_blank" class="btn btn-outline-custom btn-sm flex-grow-1">
                                                    <i class="bi bi-box-arrow-up-right me-1"></i>View Job
                                                </a>
                                                <form asp-controller="Job" asp-action="Analyze" method="post" class="flex-grow-1">
                                                    <input type="hidden" name="JobUrl" value="@job.Url" />
                                                    <button type="submit" class="btn btn-primary-gradient btn-sm w-100 apply-btn">
                                                        <i class="bi bi-magic me-1"></i>Apply with AI
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <a href="@job.Url" target="_blank" class="btn btn-outline-custom btn-sm flex-grow-1">
                                                    <i class="bi bi-box-arrow-up-right me-1"></i>View Post
                                                </a>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-4" aria-label="Search results pagination">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-controller="Job" asp-action="Search"
                                   asp-route-searchId="@Model.SearchId" asp-route-page="@(Model.CurrentPage - 1)">
                                    <i class="bi bi-chevron-left"></i> Previous
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                var pageNum = i;
                                var show = pageNum == 1
                                    || pageNum == Model.TotalPages
                                    || Math.Abs(pageNum - Model.CurrentPage) <= 2;

                                if (!show)
                                {
                                    var prev = pageNum - 1;
                                    var showPrev = prev == 1
                                        || prev == Model.TotalPages
                                        || Math.Abs(prev - Model.CurrentPage) <= 2;
                                    if (showPrev)
                                    {
                                        <li class="page-item disabled"><span class="page-link">...</span></li>
                                    }
                                    continue;
                                }

                                <li class="page-item @(pageNum == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-controller="Job" asp-action="Search"
                                       asp-route-searchId="@Model.SearchId" asp-route-page="@pageNum">@pageNum</a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-controller="Job" asp-action="Search"
                                   asp-route-searchId="@Model.SearchId" asp-route-page="@(Model.CurrentPage + 1)">
                                    Next <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        }
        else
        {
            <div class="card card-main">
                <div class="card-body">
                    <h6 class="fw-bold mb-3"><i class="bi bi-lightbulb me-2 text-primary"></i>How It Works</h6>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="p-3 rounded-3" style="background: rgba(102,126,234,.05);">
                                <i class="bi bi-briefcase text-primary fs-4 d-block mb-2"></i>
                                <strong>Job Listings</strong>
                                <p class="text-muted small mb-0">Finds formal LinkedIn job postings with "Apply with AI" support</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 rounded-3" style="background: rgba(102,126,234,.05);">
                                <i class="bi bi-chat-square-text text-primary fs-4 d-block mb-2"></i>
                                <strong>LinkedIn Posts</strong>
                                <p class="text-muted small mb-0">Discovers hiring posts from people sharing opportunities</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 rounded-3" style="background: rgba(102,126,234,.05);">
                                <i class="bi bi-funnel text-primary fs-4 d-block mb-2"></i>
                                <strong>Use Filters</strong>
                                <p class="text-muted small mb-0">Narrow results with experience level and posting date</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 rounded-3" style="background: rgba(102,126,234,.05);">
                                <i class="bi bi-magic text-primary fs-4 d-block mb-2"></i>
                                <strong>Apply with AI</strong>
                                <p class="text-muted small mb-0">Auto-generate a tailored application email for job listings</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('searchForm').addEventListener('submit', function () {
            document.getElementById('loadingOverlay').classList.add('active');
            document.querySelector('#loadingOverlay h5').textContent = 'Searching jobs & posts in Egypt...';
        });

        document.querySelectorAll('.apply-btn').forEach(function (btn) {
            btn.closest('form').addEventListener('submit', function () {
                document.getElementById('loadingOverlay').classList.add('active');
                document.querySelector('#loadingOverlay h5').textContent = 'Analyzing job with AI...';
            });
        });
    </script>
}

@functions {
    string FormatDate(string dateStr)
    {
        if (DateTime.TryParse(dateStr, out var date))
        {
            var diff = DateTime.Now - date;
            if (diff.TotalHours < 24) return "Today";
            if (diff.TotalDays < 2) return "Yesterday";
            if (diff.TotalDays < 7) return $"{(int)diff.TotalDays} days ago";
            if (diff.TotalDays < 30) return $"{(int)(diff.TotalDays / 7)} week(s) ago";
            return date.ToString("MMM dd, yyyy");
        }
        return dateStr;
    }
}
