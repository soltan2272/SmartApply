@{
    ViewData["Title"] = "Email Sent";
    var recipientEmail = TempData["RecipientEmail"]?.ToString() ?? "the recipient";
    var jobTitle = TempData["JobTitle"]?.ToString() ?? "the position";
    var companyName = TempData["CompanyName"]?.ToString() ?? "the company";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <!-- Steps indicator -->
        <div class="d-flex justify-content-center gap-4 mb-4">
            <div class="d-flex align-items-center gap-2 opacity-50">
                <span class="step-badge">1</span>
                <span class="fw-semibold">Input Job</span>
            </div>
            <div class="d-flex align-items-center gap-2 opacity-50">
                <span class="step-badge">2</span>
                <span class="fw-semibold">Preview Email</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="step-badge">3</span>
                <span class="fw-semibold text-dark">Sent!</span>
            </div>
        </div>

        <div class="card card-main text-center">
            <div class="card-body py-5">
                <div class="mb-4">
                    <div style="width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,#28a745,#20c997);display:inline-flex;align-items:center;justify-content:center;">
                        <i class="bi bi-check-lg text-white" style="font-size:2.5rem;"></i>
                    </div>
                </div>

                <h2 class="fw-bold mb-3">Email Sent Successfully!</h2>
                <p class="text-muted fs-5 mb-4">
                    Your application for <strong>@jobTitle</strong> at <strong>@companyName</strong>
                    has been sent to <strong>@recipientEmail</strong>.
                </p>

                <div class="alert alert-info d-inline-block" role="alert">
                    <i class="bi bi-info-circle me-2"></i>
                    Your CV was attached to the email automatically.
                </div>

                <div class="mt-4">
                    <a asp-controller="Job" asp-action="Index" class="btn btn-primary-gradient btn-lg">
                        <i class="bi bi-plus-circle me-2"></i>Apply to Another Job
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
