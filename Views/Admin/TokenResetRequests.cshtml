@model List<JobApplicationBot.Data.Entities.TokenResetRequest>
@{
    ViewData["Title"] = "Token Reset Requests";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="page-hero">
            <h1><i class="bi bi-arrow-counterclockwise hero-icon me-2"></i>Token Reset Requests</h1>
            <p class="lead"><a asp-action="Index">Back to dashboard</a></p>
        </div>

        @if (TempData["AdminSuccess"] is string success)
        {
            <div class="alert alert-success">@success</div>
        }
        @if (TempData["AdminError"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        <div class="card card-main">
            <div class="card-body">
                @if (Model.Count == 0)
                {
                    <p class="text-muted mb-0">No pending token reset requests.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                            <tr>
                                <th>When</th>
                                <th>User</th>
                                <th>Note</th>
                                <th></th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var r in Model)
                            {
                                <tr>
                                    <td class="small text-muted">@r.CreatedAt.ToLocalTime().ToString("g")</td>
                                    <td>@(r.User?.Email ?? r.UserId)</td>
                                    <td class="small">@(r.Note ?? "—")</td>
                                    <td class="text-end">
                                        <form asp-action="ApproveTokenReset" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <button class="btn btn-sm btn-success">Approve</button>
                                        </form>
                                        <form asp-action="RejectTokenReset" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <button class="btn btn-sm btn-outline-danger">Reject</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
