@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card card-main">
            <div class="card-body text-center py-5 px-4">
                <i class="bi bi-exclamation-triangle text-danger display-4 mb-3 d-block"></i>
                <h1 class="fw-bold mb-2">Something went wrong</h1>
                <p class="text-brand-muted mb-4">An error occurred while processing your request.</p>

                @if (Model.ShowRequestId)
                {
                    <p class="small text-brand-muted mb-4">
                        Request ID: <code>@Model.RequestId</code>
                    </p>
                }

                <a asp-controller="Home" asp-action="Index" class="btn btn-primary-gradient">
                    <i class="bi bi-house me-2"></i>Back to @AppBranding.Name
                </a>
            </div>
        </div>
    </div>
</div>
