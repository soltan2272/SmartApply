<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#4f46e5" />
    <meta name="description" content="@AppBranding.Name — @AppBranding.Tagline" />
    <title>@ViewData["Title"] - @AppBranding.Name</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="loading-overlay" id="loadingOverlay">
        <div class="spinner-custom mb-3"></div>
        <h5 class="text-brand-muted">Analyzing job with AI...</h5>
        <p class="text-brand-muted small mb-0">This may take a few seconds</p>
    </div>

    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
        <div class="container container-app">
            <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                <span class="brand-icon"><i class="bi bi-lightning-charge-fill"></i></span>
                <span class="brand-text">
                    @AppBranding.Name
                    <small class="brand-tagline">@AppBranding.Tagline</small>
                </span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>

    <main class="main-content">
        <div class="container container-app">
            @RenderBody()
        </div>
    </main>

    <footer class="footer-custom">
        <div class="container container-app text-center">
            <div class="mb-1">
                <span class="footer-brand">@AppBranding.Name</span>
            </div>
            <div class="mb-2 small">
                <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none me-3">Privacy</a>
                <a asp-controller="Home" asp-action="Terms" class="text-decoration-none me-3">Terms</a>
                <a asp-controller="Billing" asp-action="Index" class="text-decoration-none">Plans</a>
            </div>
            <small>&copy; @DateTime.Now.Year @AppBranding.Name &mdash; @AppBranding.FooterCredit</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
