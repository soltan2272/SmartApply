@page
@model JobApplicationBot.Areas.Identity.Pages.Account.ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm email";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card card-main">
            <div class="card-body text-center py-5 px-4">
                <div class="success-icon mb-4">
                    <i class="bi bi-envelope-check"></i>
                </div>
                <h1 class="fw-bold mb-3">@ViewData["Title"]</h1>
                @if (!string.IsNullOrEmpty(Model.StatusMessage))
                {
                    <p class="fs-5 text-brand-muted mb-4">@Model.StatusMessage</p>
                }
                <a asp-page="./Login" class="btn btn-primary-gradient btn-lg w-100 w-sm-auto">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Go to login
                </a>
            </div>
        </div>
    </div>
</div>
