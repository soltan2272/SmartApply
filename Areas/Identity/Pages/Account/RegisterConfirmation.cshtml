@page
@model JobApplicationBot.Areas.Identity.Pages.Account.RegisterConfirmationModel
@{
    ViewData["Title"] = "Register confirmation";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card card-main">
            <div class="card-body text-center py-5 px-4">
                <div class="success-icon mb-4">
                    <i class="bi bi-envelope-paper"></i>
                </div>
                <h1 class="fw-bold mb-3">Check your email</h1>
                <p class="text-brand-muted fs-5 mb-2">
                    We sent a confirmation link to <strong>@Model.Email</strong>.
                </p>
                <p class="text-brand-muted mb-4">
                    Click the link in that email, then sign in to @AppBranding.Name. After that, open <strong>Profile</strong> to add your Gmail App Password for sending job applications.
                </p>
                <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-primary-gradient">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Login
                    </a>
                    <a asp-page="./ResendEmailConfirmation" class="btn btn-outline-custom">
                        Resend confirmation
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
