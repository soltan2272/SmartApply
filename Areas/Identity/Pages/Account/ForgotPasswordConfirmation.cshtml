@page
@model JobApplicationBot.Areas.Identity.Pages.Account.ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card card-main">
            <div class="card-body text-center py-5 px-4">
                <div class="success-icon mb-4">
                    <i class="bi bi-envelope-check"></i>
                </div>
                <h1 class="fw-bold mb-3">Check your email</h1>
                <p class="text-brand-muted fs-5 mb-4">
                    If an account with that email exists, we sent a password reset link from @AppBranding.Name.
                    Check your inbox and spam folder.
                </p>
                <a asp-page="./Login" class="btn btn-primary-gradient btn-lg w-100 w-sm-auto">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Back to login
                </a>
            </div>
        </div>
    </div>
</div>
