@page
@model JobApplicationBot.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="page-hero">
            <h1>
                <i class="bi bi-box-arrow-in-right hero-icon me-2"></i>
                @ViewData["Title"]
            </h1>
            <p class="lead">Sign in to @AppBranding.Name</p>
        </div>

        <div class="card card-main">
            <div class="card-body">
                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label fw-semibold">Email</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label fw-semibold">Password</label>
                        <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label asp-for="Input.RememberMe" class="form-check-label">@Html.DisplayNameFor(m => m.Input.RememberMe)</label>
                    </div>

                    <button id="login-submit" type="submit" class="btn btn-primary-gradient btn-lg w-100">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Log in
                    </button>

                    <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 mt-3 small">
                        <a asp-page="./ForgotPassword">Forgot your password?</a>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register as a new user</a>
                    </div>
                    <p class="text-center mt-2 small mb-0">
                        <a asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
                    </p>
                </form>
            </div>
        </div>

        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="card card-main mt-4">
                <div class="card-body">
                    <h6 class="fw-bold mb-3 text-center">Or sign in with</h6>
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="d-flex flex-wrap gap-2 justify-content-center">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" class="btn btn-outline-custom" name="provider" value="@provider.Name" title="@provider.DisplayName">
                                <i class="bi bi-google me-1"></i>@provider.DisplayName
                            </button>
                        }
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
